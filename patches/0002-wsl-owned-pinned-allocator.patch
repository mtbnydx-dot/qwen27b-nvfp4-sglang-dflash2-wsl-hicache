+@lru_cache(maxsize=None)
+def _host_pointer_aliasing_required(device_index: int) -> bool:
+    from cuda.bindings import runtime
+
+    error, supported = runtime.cudaDeviceGetAttribute(
+        runtime.cudaDeviceAttr.cudaDevAttrCanUseHostPointerForRegisteredMem,
+        device_index,
+    )
+    if int(error) != 0:
+        raise RuntimeError("Cannot verify CUDA host-pointer capability")
+    return not bool(supported)
+
+
+def _alloc_wsl_owned_host_tensor(dims, dtype, device):
+    """Opt-in WSL workaround for the separate AOT direct-copy path.
+
+    PyTorch-owned pinned allocation has a device-visible address. Keep ownership
+    with PyTorch, and never cudaHostUnregister its allocation during teardown.
+    This only serves in-memory L2; custom/shared/distributed allocators are not
+    replaced. Unlike the upstream JIT patch, this also covers direct Mamba IO.
+    """
+    from cuda.bindings import runtime
+
+    assert device == "cpu"
+    buffer = torch.empty(dims, dtype=dtype, device=device, pin_memory=True)
+    if buffer.numel():
+        error, alias = runtime.cudaHostGetDevicePointer(buffer.data_ptr(), 0)
+        if int(error) != 0 or int(alias) != buffer.data_ptr():
+            raise RuntimeError("WSL HiCache pinned allocation has no matching device alias")
+    setattr(buffer, _CUDA_HOST_REGISTERED_RANGES_ATTR, [])
+    logger.info("WSL HiCache owned-pinned allocator: %.2f GB, same device alias verified", buffer.numel() * buffer.element_size() / 1e9)
+    return buffer
+
